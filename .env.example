# ==========================================================
# MEDQUEUE ENVIRONMENT CONFIGURATION
# ==========================================================

# Supabase PostgreSQL & Auth Credentials
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Hospital Application Settings
VITE_HOSPITAL_NAME="St. Jude Memorial & Specialty Hospital"
VITE_ENABLE_SPEECH_SYNTHESIS=true
VITE_DEFAULT_SCHEDULING_MODE=FIFO
VITE_AUDIO_CHIME_ENABLED=true
